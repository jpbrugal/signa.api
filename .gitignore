###########################################################
# Signa API (.NET 9) Gitignore
# Environment: Visual Studio / VS Code / Rider / JetBrains
###########################################################
# JetBrains / Rider / IntelliJ
.idea/
.idea/**/
.idea/**/*
*.iml
*.ipr
*.iws
*.DotSettings.user


# Build artifacts
bin/
obj/
out/
publish/
artifacts/


# User-specific files
*.user
*.rsuser
*.suo
*.userosscache
*.sln.docstates

# Visual Studio / JetBrains
.vs/
.idea/
*.DotSettings.user

# Logs and debugging
*.log
logs/
*.stackdump

# Environment files
.env
.env.*
!*.env.example   # keep sample files

# OS / editor files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.tmp
*.bak

# Package managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database / local data
*.db
*.sqlite
*.mdf
*.ldf

# Migrations (optional – uncomment if you regenerate them automatically)
# Migrations/

# Publish profiles & secrets
Properties/PublishProfiles/
secrets.json
appsettings.Development.json  # exclude local configs
# keep base config files
!appsettings.json

# Test and coverage
TestResults/
coverage/
*.coverage
*.coveragexml

# Docker / container
docker-compose.override.yml
.docker/

# Temporary / cache
*.cache
*.tmp
*.pid
*.seed
*.log
*.bak
*.zip
*.tar
*.gz

###########################################################
# END
###########################################################
